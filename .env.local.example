# Copiez ce fichier en .env.local et remplissez vos propres valeurs.
# Tant que ces variables ne sont pas renseignées, le site tourne avec les
# données de démonstration de lib/data.js (aucun compte externe requis).

# Supabase (base de données + connexion par lien magique)
# 1. Créez un projet sur https://supabase.com (compte à créer vous-même)
# 2. npm install @supabase/supabase-js @supabase/ssr
# 3. Renseignez les deux valeurs ci-dessous depuis Project Settings > API
#    (la clé "publishable"/anon — jamais la clé "secret")
# 4. Exécutez supabase/001_demandes_sur_mesure.sql puis
#    supabase/002_pieces_et_carnet.sql dans le SQL Editor de votre projet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site — utilisée pour construire le lien de retour du mail
# de connexion. En local, la valeur par défaut (http://localhost:3000) suffit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (emails transactionnels : lien de connexion, confirmation de commande)
# Créez un compte sur https://resend.com et un domaine vérifié
RESEND_API_KEY=

# Stripe (paiement) — volontairement laissé de côté pour l'instant,
# voir la note dans README.md
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
